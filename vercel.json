{
  "redirects": [
    {
      "source": "/((?!ads\\.txt$|robots\\.txt$).*)",
      "has": [{ "type": "host", "value": "dewdew.world" }],
      "destination": "https://www.dewdew.world/$1",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/policy",
      "destination": "/en/privacy",
      "permanent": false
    }
  ],
  "buildCommand": "bun run build",
  "outputDirectory": "dist"
}
