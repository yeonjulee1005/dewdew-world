---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { Image } from 'astro:assets'
import Link from '@components/Link.astro'
import LocaleSelect from '@components/LocaleSelect.astro'
import PresenceIndicator from '@components/PresenceIndicator.astro'
import dewdewWorldImage from '../../assets/images/dewdew_world.webp'

import { MENU_ITEMS } from '../../i18n/consts.ts'
import { type Lang } from '../../i18n.ts'

const locale = Astro.currentLocale as Lang;
---
<div class='relative w-screen items-center justify-between border-b border-neutral-700 px-4 py-5 lg:hidden lg:w-[1000px] lg:px-0'>
  <div class='flex items-center gap-3'>
    <Link
      link={getRelativeLocaleUrl(locale, '/')}
      customClass='flex items-center gap-1'
      target='_self'
      label='dewdew'
    >
      <span
        slot='link'
        class='cursor-pointer text-3xl font-bold text-red-400 duration-200 hover:text-rose-600 hover:opacity-90 hover:transition-opacity'
      >
        {MENU_ITEMS[locale as keyof typeof MENU_ITEMS].nav.dewdew}
      </span>
      <Image
        slot='link'
        class='cursor-pointer rounded-full border border-neutral-700 duration-200 hover:border-rose-600 hover:opacity-90 hover:transition-opacity'
        src={dewdewWorldImage}
        width={30}
        height={30}
        quality={80}
        loading='eager'
        alt='logo-mobile'
      />
    </Link>
    <PresenceIndicator />
  </div>
  <div class='flex-auto' />
  <div class='flex flex-wrap items-center gap-x-3 gap-y-1 my-2'>
    <Link
      text={MENU_ITEMS[locale as keyof typeof MENU_ITEMS].nav.uses}
      link={getRelativeLocaleUrl(locale, 'uses')}
      customClass='cursor-pointer text-lg text-red-400 duration-200 hover:text-rose-600 hover:opacity-90 hover:transition-opacity'
      target='_self'
      label='uses'
    />
    <div class='h-4 border-r border-neutral-700' />
    <Link
      text={MENU_ITEMS[locale as keyof typeof MENU_ITEMS].nav.tech}
      link={getRelativeLocaleUrl(locale, 'tech')}
      customClass='cursor-pointer text-lg text-red-400 duration-200 hover:text-rose-600 hover:opacity-90 hover:transition-opacity'
      target='_self'
      label='tech'
    />
    <div class='h-4 border-r border-neutral-700' />
    <Link
      text={MENU_ITEMS[locale as keyof typeof MENU_ITEMS].nav.guestbook}
      link={getRelativeLocaleUrl(locale, 'guestbook').replace(/\/$/, '')}
      customClass='cursor-pointer text-lg text-red-400 duration-200 hover:text-rose-600 hover:opacity-90 hover:transition-opacity'
      target='_self'
      label='guestbook'
    />
    <div class='h-4 border-r border-neutral-700' />
    <Link
      text={MENU_ITEMS[locale as keyof typeof MENU_ITEMS].nav.dewdewDev}
      link='https://www.dewdew.dev/ai'
      customClass='cursor-pointer text-lg text-red-400 duration-200 hover:text-rose-600 hover:opacity-90 hover:transition-opacity'
      target='_blank'
      label='dewdew'
    />
    <div class='h-4 border-r border-neutral-700' />
    <LocaleSelect devices='mobile' />
  </div>
</div>
