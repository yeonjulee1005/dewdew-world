---
import Blocks from './Blocks.astro'
import type { PrivacySection } from '../../i18n/privacy.ts'

interface Props {
  section: PrivacySection
  locale: 'en' | 'ko'
}

const { section, locale } = Astro.props
---
<section class='pt-6'>
  <h3 class='text-xl font-bold break-keep'>{section.title[locale]}</h3>
  <Blocks blocks={section.body[locale]} />
</section>
