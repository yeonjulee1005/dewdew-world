---
import { LOCALES } from '../i18n'

// 실제 댓글 역사가 쌓여 있는 쪽은 'ko' 스레드이므로, 사이트 기본 로케일(en) 설정과는
// 무관하게 댓글 term의 기준 로케일은 항상 'ko'로 고정한다.
const GISCUS_CANONICAL_LOCALE = 'ko'

interface Props {
  giscusCategory: string
  giscusCategoryId: string
}

const {
  giscusCategory,
  giscusCategoryId
} = Astro.props

const locale = Astro.currentLocale as string;
const localeCodes = Object.keys(LOCALES)
const localePrefixPattern = new RegExp(`^/(${localeCodes.join('|')})(?=/|$)`)

// 기존 giscus 디스커션은 'ko/tech/20250714'처럼 언어 접두사를 포함한 pathname(앞 슬래시 없이)을
// 제목으로 쓰고 있었음. ko/en 버전이 같은 글이면 동일한 스레드를 쓰도록, 실제 보고 있는 언어와
// 무관하게 항상 기본 로케일(ko) 기준 term으로 고정해 기존 댓글이 쌓인 스레드를 그대로 재사용함.
const currentPath = `${GISCUS_CANONICAL_LOCALE}${Astro.url.pathname
  .replace(/\.mdx/g, '')
  .replace(localePrefixPattern, '')
  .replace(/\/$/, '')}`

---

<giscus-widget
  repo="yeonjulee1005/dewdew-world"
  repoid="R_kgDOLF55BQ"
  category={giscusCategory}
  categoryid={giscusCategoryId}
  mapping="specific"
  term={currentPath}
  strict="0"
  reactionsenabled="1"
  emitmetadata="1"
  inputposition="top"
  theme="light_protanopia"
  lang={locale}
  crossorigin="anonymous"
  async
  loading="eager"
  >
</giscus-widget>

<script>
  import 'giscus'
</script>
