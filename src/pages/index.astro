---
import {
  useTranslations,
  getLocalePaths,
  LOCALES,
  DEFAULT_LOCALE,
  type Lang,
} from "../i18n.ts";
import { SITE_TITLE, SITE_DESCRIPTION } from "../i18n/consts.ts";

const t = useTranslations(Astro.currentLocale as Lang);
const langs = Object.keys(LOCALES);
// 같은 origin으로 보내는 리다이렉트라 절대 URL이 필요 없음.
// import.meta.env.PROD 기준으로 분기하면 로컬에서 production 빌드를 미리보기할 때도
// (astro build && astro preview) 실제 운영 도메인(Astro.site)으로 튕겨나가는 문제가 있었음.
const baseUrl = "/";
const defaultLocale = DEFAULT_LOCALE;
---

<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="UTF-8" />
    <title>redirect...</title>
    <link rel="canonical" href={Astro.site?.origin + "/en/"} />
    <meta name="generator" content={Astro.generator} />
    {
      getLocalePaths(Astro.url).map((props) => (
        <link
          rel="alternate"
          hreflang={LOCALES[props.lang].lang || props.lang}
          href={Astro.site?.origin + props.path}
        />
      ))
    }

    <!-- icon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="192x192" href="/android-chrome.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="light dark" />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t(SITE_TITLE)} />
    <meta property="og:site_name" content={t(SITE_TITLE)} />
    <meta property="og:description" content={t(SITE_DESCRIPTION)} />
    <meta property="og:image" content={Astro.site + "ogp.png"} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:locale" content={DEFAULT_LOCALE} />
    <meta name="twitter:card" content="summary" />

    <noscript>
      <meta
        http-equiv="refresh"
        content={`0;url=${baseUrl + DEFAULT_LOCALE}/`}
      />
    </noscript>

    <script is:inline define:vars={{ langs, baseUrl, defaultLocale }}>
      if (
        localStorage.selectedLang &&
        langs.includes(localStorage.selectedLang)
      ) {
        window.location.href = `${baseUrl + localStorage.selectedLang}/`;
      } else {
        const browserLang = navigator.language.toLowerCase();

        if (langs.includes(browserLang)) {
          window.location.href = `${baseUrl + browserLang}/`;
        } else if (langs.includes(browserLang.split("-")[0])) {
          window.location.href = `${baseUrl + browserLang.split("-")[0]}/`;
        } else {
          window.location.href = `${baseUrl + defaultLocale}/`;
        }
      }
    </script>
  </head>
  <body>
    <div class="bg-white"></div>
  </body>
</html>